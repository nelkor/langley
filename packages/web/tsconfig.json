{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "nodenext",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["esnext", "dom"],
    "types": ["vite/client"],
    "moduleResolution": "nodenext",

    /* Alias */
    "paths": { "@/*": ["./src/*"] },
  },
  "include": ["src/*.ts", "src/*.tsx"]
}
